# ---------------------------------------------------------------
# Copy this file to .env.local and fill in the values for local dev.
# Required vars are validated at startup by src/lib/env.ts.
# ---------------------------------------------------------------

# --- Core ---
NODE_ENV=development

# --- Database ---
# For local dev with the supplied docker-compose.yml:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agents

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

# Email magic link provider.
# In dev, leave AUTH_EMAIL_FROM empty and links will be logged to the console.
AUTH_EMAIL_FROM=
# If you want real email in dev, set these (e.g. via Resend or SMTP):
# AUTH_RESEND_API_KEY=
# or
# AUTH_EMAIL_SERVER=smtp://user:pass@host:587

# --- LLM provider selection ---
# One of: mock | minimax
# Defaults to "mock" so the app works with no third-party keys.
LLM_PROVIDER=mock

# --- MiniMax (only required when LLM_PROVIDER=minimax) ---
# Add this AFTER the full stack is built.
MINIMAX_API_KEY=
# MiniMax's Anthropic-compatible endpoint. Confirm current URL in their docs:
# https://platform.minimax.io/docs/api-reference/text-anthropic-api
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# --- Encryption (for stored integration tokens, used PR 4+) ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-me

# --- GitHub OAuth (PR 4+) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Inngest (PR 5+) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
